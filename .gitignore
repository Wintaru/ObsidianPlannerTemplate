# Personal content folders (synced via OneDrive, not git)
# Add any new personal folders here to keep them out of the repo
# .gitkeep files are excepted so folder structure is preserved for cloners
Projects/
!Projects/**/.gitkeep
Work Journal/
!Work Journal/**/.gitkeep
Images/
!Images/.gitkeep
Contacts/
!Contacts/.gitkeep
Learning/

# Exclude any loose markdown files at the root (personal notes, scratch pads, etc.)
# Template/infrastructure files committed above are explicitly tracked
/*.md
!CLAUDE.md
!AI\ Notes.md
!Getting\ Started.md
!Obsidian\ Reference\ Guide.md
!Markdown\ Cheat\ Sheet.md
!Plugin\ Recommendations.md

# Obsidian plugin bundles and version metadata (reinstalled/updated automatically)
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css
.obsidian/plugins/*/manifest.json

# Obsidian workspace state (changes constantly, machine-specific)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json

# OS files
.DS_Store
.trash/
